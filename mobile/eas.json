{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:5080",
        "EXPO_PUBLIC_ALLOW_HTTP": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://app-vivi-api-hwbmc3dzhkewa5hb.centralindia-01.azurewebsites.net",
        "EXPO_PUBLIC_ALLOW_HTTP": "false"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://app-vivi-api-hwbmc3dzhkewa5hb.centralindia-01.azurewebsites.net",
        "EXPO_PUBLIC_ALLOW_HTTP": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
