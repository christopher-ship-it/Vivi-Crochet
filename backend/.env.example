# VIVI Crochet API — environment variables
# Copy into `dotnet user-secrets` (local) or Azure App Service Application Settings.
# NEVER commit real production secrets to Git.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production

# --- Required: JWT signing (min 32 characters) ---
Jwt__SigningKey=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_STRING
Jwt__Issuer=vivi-api
Jwt__Audience=vivi-clients
Jwt__AccessTokenMinutes=480

# --- First admin (only when AdminUsers table is empty; remove password after first login) ---
Seed__AdminEmail=admin@vivicrochet01.com
Seed__AdminPassword=REPLACE_WITH_A_STRONG_PASSWORD
Seed__AdminName=Vivi Priya

# --- Support inbox (email when a customer sends Chat with us) ---
Support__InboxEmail=support@vivicrochet01.com

# --- Resend (order / course / live booking confirmation emails) ---
# Domain vivicrochet01.com must be verified in Resend. From address must be on that domain.
Resend__ApiKey=REPLACE_WITH_RESEND_API_KEY
Resend__FromEmail=support@vivicrochet01.com
Resend__FromName=VIVI Crochet

# --- Expo push (weekly job secret; min 16 chars for /api/internal/jobs/weekly-push) ---
# Azure: schedule POST https://<api>/api/internal/jobs/weekly-push?force=false Mondays ~09:30 IST
# Header: X-Vivi-Job-Secret: <same as Push__JobSecret>
Push__Enabled=true
Push__JobSecret=REPLACE_WITH_A_RANDOM_16_PLUS_CHARACTER_STRING

# --- Azure SQL ---
ConnectionStrings__DefaultConnection=Server=tcp:sql-vivi.database.windows.net,1433;Initial Catalog=sqldb-vivi;User ID=vivi_app;Password=REPLACE;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# --- Azure Blob Storage (server-side only — never expose to Admin or Mobile) ---
Blob__Provider=Azure
Blob__ConnectionString=DefaultEndpointsProtocol=https;AccountName=stviviREPLACE;AccountKey=REPLACE;EndpointSuffix=core.windows.net
Blob__ContainerName=videos
Blob__UploadSasMinutes=30
Blob__ReadSasMinutes=15
Blob__MaxUploadBytes=2147483648

# --- FFmpeg (H.264 mobile compress after upload; leave ExecutablePath empty to auto-detect) ---
# Tuned for App Service B2: Preset=ultrafast, MaxWidth=720, MaxFps=24, Crf=24
# FFmpeg__ExecutablePath=/usr/bin/ffmpeg
# FFmpeg__Crf=24
# FFmpeg__MaxWidth=720
# FFmpeg__MaxFps=24
# FFmpeg__Preset=ultrafast
# FFmpeg__AudioBitrate=96k
# --- Database migrations ---
# Production: set false and run `dotnet ef database update` during deployment.
# Development: true (default in appsettings.Development.json).
Database__AutoMigrate=false
Database__AutoSeed=true

# --- Temporary mobile login (disable when OTP is live in production) ---
# Auth__AllowDevCustomerLogin=true

# --- 2Factor phone OTP (shopping checkout) — set in Azure App Settings, never commit ---
# TwoFactor__ApiKey=REPLACE_WITH_2FACTOR_API_KEY
# TwoFactor__Template=Login_Verification_OTP
# TwoFactor__Enabled=true

# --- API CORS (admin SPA origins only — mobile apps do not use browser CORS) ---
# Azure App Service array syntax:
Cors__AllowedOrigins__0=https://admin.vivicrochet01.com
Cors__AllowedOrigins__1=http://localhost:5173
# Cors__AllowedOrigins__2=https://vivi-admin-hmayf7b6fyfwasge.centralindia-01.azurewebsites.net

# --- Application Insights (recommended in production) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=REPLACE;IngestionEndpoint=https://centralindia-0.in.applicationinsights.azure.com/

# --- App Service health check path (configure in Portal) ---
# WEBSITE_HEALTHCHECK_PATH=/api/health
